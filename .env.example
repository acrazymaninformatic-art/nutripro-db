# =========================================================
# CONFIGURACIÓN EVSOFTWARE PARA VERCEL + POSTGRESQL / SUPABASE (100% GRATUITO)
# =========================================================

# 1. Base de Datos Supabase (PostgreSQL gratuito en Fráncfort - UE)
# En Supabase > Project Settings > Database > Connection string:
# Modo "Transaction" (puerto 6543) para Next.js en Vercel
DATABASE_URL="postgresql://postgres.[TU_PROYECTO]:[TU_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Modo "Session / Direct" (puerto 5432) para migraciones de Prisma
DIRECT_URL="postgresql://postgres.[TU_PROYECTO]:[TU_PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# 2. Seguridad y URL de tu dominio en Vercel
NEXTAUTH_SECRET="tu-clave-secreta-larga-y-aleatoria"
AUTH_SECRET="genera-una-clave-aleatoria-distinta-de-al-menos-32-caracteres"
CRON_SECRET="genera-otra-clave-aleatoria-para-proteger-los-recordatorios"
EVSOFTWARE_ADMIN_EMAIL="evavidalinfo@gmail.com"
EVSOFTWARE_ADMIN_PASSWORD="usa-una-contraseña-aleatoria-de-14-caracteres-o-mas"
NEXTAUTH_URL="https://tu-proyecto.vercel.app"
APP_PUBLIC_URL="https://tu-proyecto.vercel.app"

# 3. Envío Automático de Correos (Gmail SMTP gratuito con Contraseña de Aplicación)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_de_16_letras"
SMTP_FROM="tu-correo@gmail.com"
SMTP_FROM_NAME="Tu Nombre - Consulta de Nutrición"
