generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Note: SQLite doesn't support enums natively.
// Valid values are enforced at the application level.
// Sex: "MALE" | "FEMALE"
// Objective: "WEIGHT_LOSS" | "MUSCLE_GAIN" | "MAINTENANCE" | "HEALTH_IMPROVEMENT" | "SPORTS_PERFORMANCE"
// ActivityLevel: "SEDENTARY" | "LIGHT" | "MODERATE" | "ACTIVE" | "VERY_ACTIVE"
// MealType: "BREAKFAST" | "MID_MORNING" | "LUNCH" | "SNACK" | "DINNER" | "LATE_SNACK"

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  passwordChangeRequired Boolean @default(false)
  passwordResetTokenHash String? @unique
  passwordResetExpiresAt DateTime?
  passwordResetRequestedAt DateTime?
  role          String     @default("ADMIN") // "ADMIN" | "PATIENT"
  patientId     String?    @unique
  patientAccount Patient?  @relation("PatientAccount", fields: [patientId], references: [id], onDelete: Cascade)
  image         String?
  licenseNumber String?
  clinicName    String?
  phone         String?
  address       String?
  sessionRevokedAt DateTime? // Invalidates all existing sessions when set (e.g. portal access blocked)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patients      Patient[]  @relation("NutritionistPatients")
  recipes       Recipe[]
  mealPlans     MealPlan[]
  waitlistEntries WaitlistEntry[]
  invoices      Invoice[]
  dataRequests  DataSubjectRequest[]
  auditLogs     AuditLog[]
  agendaBlocks  AgendaBlock[]
  questionnaireTemplates QuestionnaireTemplate[]
  customFoods   Food[]
  absorptionRules AbsorptionInteractionRule[]
  foodMergeLogs FoodDuplicateMergeLog[]
}

model Patient {
  id                 String          @id @default(uuid())
  userId             String
  user               User            @relation("NutritionistPatients", fields: [userId], references: [id], onDelete: Cascade)
  portalUser         User?           @relation("PatientAccount")
  firstName          String
  lastName           String
  email              String?
  phone              String?
  birthDate          DateTime
  sex                String          // "MALE" | "FEMALE"
  heightCm           Float
  objective          String          // Objective enum values
  activityLevel      String          // ActivityLevel enum values
  notes              String?
  allergies          String          @default("") // Comma-separated values
  allergiesStatus    String          @default("NO_CONSTA") // "NO_CONSTA" | "NINGUNA_CONOCIDA" | "CONFIRMED"
  intolerances       String          @default("") // Comma-separated values
  intolerancesStatus String          @default("NO_CONSTA") // "NO_CONSTA" | "NINGUNA_CONOCIDA" | "CONFIRMED"
  dietaryPreferences String          @default("") // Comma-separated values
  referralSource     String?

  // === CLINICAL HISTORY (Page 2) ===
  medicalHistory        String   @default("")  // Comma-separated: diabetes, hipertensión, etc.
  pathologiesStatus     String   @default("NO_CONSTA") // "NO_CONSTA" | "NINGUNA_CONOCIDA" | "CONFIRMED"
  currentMedications    String   @default("")  // Comma-separated medication list
  medicationsStatus     String   @default("NO_CONSTA") // "NO_CONSTA" | "NINGUNA_CONOCIDA" | "CONFIRMED"
  supplements           String   @default("")  // Current supplements
  surgeries             String   @default("")  // Past surgeries
  familyHistory         String   @default("")  // Family medical history

  // === DIGESTIVE & METABOLISM (Page 3) ===
  digestiveIssues       String   @default("")  // Comma-separated: reflujo, hinchazón, estreñimiento
  bowelFrequency        String?  // daily, every_other_day, irregular
  foodAversions         String   @default("")  // Foods the patient dislikes/avoids
  waterIntakeLiters     Float?   // Daily water intake
  caffeineDaily         Int?     // Number of coffees/teas per day
  alcoholFrequency      String?  // none, occasional, weekly, daily
  smoking               Boolean  @default(false)

  // === LIFESTYLE & HABITS (Page 4) ===
  occupation            String?
  workSchedule          String?  // morning, afternoon, night, rotating
  sleepHours            Float?   // Average hours of sleep
  sleepQuality          String?  // good, regular, poor, insomnia
  stressLevel           String?  // low, moderate, high, very_high
  mealSchedule          String   @default("")  // Typical meal times JSON
  mealsPerDay           Int?     // Number of meals per day
  eatsOut               String?  // never, rarely, weekly, daily
  cooksAtHome           Boolean  @default(true)

  // === EXERCISE & SPORTS (Page 5) ===
  exerciseType          String   @default("")  // Comma-separated: running, weights, swimming
  exerciseFrequency     Int?     // Times per week
  exerciseDuration      Int?     // Minutes per session
  exerciseTime          String?  // morning, afternoon, evening
  sportGoals            String   @default("")  // Competition goals
  trainingExperience    String?  // beginner, intermediate, advanced, elite

  // === WOMEN'S HEALTH (Page 6) ===
  menstrualCycle        String?  // regular, irregular, amenorrhea, menopause, not_applicable
  pregnant              Boolean  @default(false)
  breastfeeding         Boolean  @default(false)
  contraceptive         String?  // none, hormonal, iud, other
  hormoneTherapy        Boolean  @default(false)

  // === CLINICAL GOALS & PRIORITIES (Page 7) ===
  shortTermGoal         String?  // Goal for 1-3 months
  longTermGoal          String?  // Goal for 6-12 months
  motivation            String?  // health, aesthetics, performance, medical
  previousDiets         String   @default("")  // Past diet attempts
  dietDuration          String?  // How long they want to follow the plan
  consultationFrequency String?  // weekly, biweekly, monthly
  budgetLevel           String?  // low, medium, high
  additionalNotes       String?  // Extra notes from intake

  // === CLINICAL GOALS & TRACKING (5.2) ===
  targetWeightKg        Float?   // Peso objetivo acordado con Eva
  targetWeightDate      DateTime? // Fecha meta para el objetivo
  weeklyChangeTargetKg  Float?   // Ritmo semanal de cambio objetivo (ej: -0.5 kg/sem)
  tags                  String   @default("") // Etiquetas clínicas privadas con color: [{"name":"SOP","color":"#ec4899"}]
  medicationSchedule    String   @default("") // Medicación y suplementos con dosis y horario estructurado
  milestonesMessage     String?  // Mensaje personalizado de Eva para hitos y enhorabuenas
  isDischarged          Boolean  @default(false) // Alta clínica / Cierre de seguimiento
  dischargedAt          DateTime?
  dischargeSummary      String?  // Resumen del alta clínica

  // === ADVANCED CLINICAL PROTOCOLS ===
  isGLP1Treatment       Boolean  @default(false) // Paciente en tratamiento con análogos GLP-1 (Ozempic/Wegovy)
  isTCAProtocol         Boolean  @default(false) // Protocolo TCA (ocultar números y centrarse en hábitos)

  // === ANAMNESIS DIGITAL PRE-CONSULTA ===
  anamnesisStatus       String   @default("NOT_SENT") // "NOT_SENT" | "PENDING" | "COMPLETED"
  anamnesisSentAt       DateTime?
  anamnesisCompletedAt  DateTime?
  anamnesisAccessTokenHash String?    @unique
  anamnesisAccessTokenExpiresAt DateTime?
  consentAcceptedAt   DateTime?
  consentPolicyVersion String?
  consentRevokedAt    DateTime?
  consentRevocationReason String?

  // === PORTAL DEL PACIENTE & SEGURIDAD ===
  portalAccessEnabled Boolean         @default(true)
  portalLastLoginAt   DateTime?
  isHardDeleted       Boolean         @default(false)

  // === ESTADOS DE ENTREGA 5.4 & PROCEDENCIA ===
  questionnaireDeliveryStatus String  @default("NOT_SENT") // "NOT_SENT" | "SENT" | "IN_PROGRESS" | "COMPLETED"
  consentDeliveryStatus       String  @default("NOT_SENT") // "NOT_SENT" | "SENT" | "IN_PROGRESS" | "COMPLETED"
  declaredWeightKg            Float?  // Peso declarado por paciente (no medido; fuera de gráficas de evolución)
  declaredHeightCm            Float?  // Altura declarada por paciente
  fieldProvenanceJson         String? // Trazabilidad de origen por campo: quién, cuándo, valor previo
  pendingReviewFieldsCount    Int     @default(0) // Contador de campos pendientes de revisión por Eva

  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  anthropometries      Anthropometry[]
  mealPlans            MealPlan[]
  consultations        Consultation[]
  appointments         Appointment[]
  bloodAnalyses        BloodAnalysis[]
  anamnesisSubmissions AnamnesisSubmission[]
  waitlistEntries      WaitlistEntry[]
  invoices             Invoice[]
  dataRequests         DataSubjectRequest[]
  auditLogs            AuditLog[]
  clinicalCheckIns     ClinicalCheckIn[]
  consents             PatientConsent[]
  documents            PatientDocument[]
  emailLogs            EmailLog[]
  screenings           ClinicalScreening[]
  photos               ProgressPhoto[]
  patientQuestionnaires PatientQuestionnaire[]
  appointmentRequests  AppointmentRequest[]
  clinicalProtocols    ClinicalProtocolRecord[]
  calculatorResults    CalculatorResultRecord[]

  @@index([userId])
}

model AnamnesisSubmission {
  id                  String    @id @default(cuid())
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  submittedAt         DateTime  @default(now())

  // Datos declarados por la paciente (en sus propias palabras)
  declaredName        String?
  declaredPhone       String?
  declaredEmail       String?
  declaredBirthDate   DateTime?
  declaredGender      String?
  
  // Hábitos y Nutrición
  foodPreferences     String?
  foodAversions       String?
  mealsPerDay         Int?
  mealScheduleNotes   String?
  waterIntakeLiters   Float?
  otherBeverages      String?
  recall24h           String?
  weekendHabits       String?
  
  // Salud, Medicación y Síntomas
  digestiveIssues     String?
  digestiveSymptoms   String?
  medicalHistory      String?
  currentMedications  String?
  isGLP1Treatment     Boolean   @default(false)
  intolerancesOrAllergies String?

  // Estilo de vida y bienestar
  exerciseRoutine      String?
  sleepAndStress       String?
  emotionalEatingNotes String?
  previousDietsExp     String?
  supplementsNotes     String?
  shortTermGoal        String?

  @@index([patientId])
}

model BloodAnalysis {
  id                String   @id @default(cuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date              DateTime
  glucoseMgDl       Float?   // Glucosa basal (mg/dL) - ref: 70-100
  hba1cPct          Float?   // HbA1c (%) - ref: <5.7
  cholesterolMgDl   Float?   // Colesterol Total (mg/dL) - ref: <200
  hdlMgDl           Float?   // HDL (mg/dL) - ref: >40/50
  ldlMgDl           Float?   // LDL (mg/dL) - ref: <100
  triglyceridesMgDl Float?   // Triglicéridos (mg/dL) - ref: <150
  ferritinNgMl      Float?   // Ferritina (ng/mL) - ref: 30-300
  tshUiuMl          Float?   // TSH (µIU/mL) - ref: 0.4-4.0
  vitaminDNgMl      Float?   // Vitamina D 25-OH (ng/mL) - ref: 30-100
  creatinineMgDl    Float?   // Creatinina (mg/dL) - ref: 0.7-1.2
  uricAcidMgDl      Float?   // Ácido Úrico (mg/dL) - ref: 3.5-7.2
  gotAstUL          Float?   // GOT/AST (U/L) - ref: <35
  gptAltUL          Float?   // GPT/ALT (U/L) - ref: <45
  insulinUiuMl      Float?   // Insulina basal (µIU/mL) - para cálculo HOMA-IR
  plateletsKUl      Float?   // Plaquetas (10^3/µL) - para cálculo FIB-4
  notes             String?
  createdAt         DateTime @default(now())

  @@index([patientId])
}

model Anthropometry {
  id                  String   @id @default(cuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                DateTime
  weightKg            Float
  bodyFatPct          Float?
  muscleMassKg        Float?
  visceralFat         Float?
  waistCm             Float?
  hipCm               Float?
  chestCm             Float?
  armCm               Float?
  thighCm             Float?
  skinfoldTriceps     Float?
  skinfoldSubscapular Float?
  skinfoldSuprailiac  Float?
  skinfoldAbdominal   Float?
  skinfoldBiceps      Float?
  skinfoldCalf        Float?
  boneDiameterWrist   Float?   // Diámetro biestiloideo muñeca (cm)
  boneDiameterFemur   Float?   // Diámetro bicondíleo fémur (cm)
  boneDiameterHumerus Float?   // Diámetro biepicondilar húmero (cm)
  somatotypeEndo      Float?   // Endomorfia Heath-Carter
  somatotypeMeso      Float?   // Mesomorfia Heath-Carter
  somatotypeEcto      Float?   // Ectomorfia Heath-Carter
  waistToHeightRatio  Float?   // ICT: cintura / altura (<0.5 óptimo)
  cunBaeFatPct        Float?   // Estimación CUN-BAE
  phaseAngle          Float?   // Ángulo de fase BIA (grados)
  notes               String?
  isPublishedToPatient Boolean @default(true)
  createdAt           DateTime @default(now())

  @@index([patientId])
}

model Consultation {
  id                  String   @id @default(cuid())
  patientId           String
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date                DateTime
  notes               String?
  // SOAP Notes
  subjectiveNotes     String?  // S: Lo que el paciente refiere (ánimo, apetito, dificultades)
  objectiveNotes      String?  // O: Datos medidos y observaciones de consulta
  assessmentNotes     String?  // A: Juicio clínico y diagnóstico de evolución
  planNotes           String?  // P: Pautas acordadas y próximos pasos
  attachments         String?  // Adjuntos de consulta (JSON)
  clinicianSignature  String?  // Firma clínica digital
  patientSummary      String?  // Resumen automático generado para el paciente
  isSharedWithPatient Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([patientId])
}

model ClinicalCheckIn {
  id               String   @id @default(cuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  adherencePct     Int      // 0-100, estimated adherence to the current plan
  digestionScore   Int?     // 0-10, patient-reported digestive comfort
  habitsScore      Int?     // 0-10, patient-reported habits/routine
  notes            String?
  createdAt        DateTime @default(now())

  @@index([patientId, date])
}

model Appointment {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date           DateTime
  durationMin    Int       @default(45)
  modality       String    @default("ONLINE") // "ONLINE" | "PRESENCIAL"
  status         String    @default("CONFIRMED") // "CONFIRMED" | "COMPLETED" | "CANCELLED"
  appointmentType String   @default("REVISION")  // "PRIMERA" | "REVISION" | "ONLINE" | "DOMICILIO" | "GRUPAL"
  typeColor      String    @default("#16a34a")   // Color de la cita en agenda
  location       String?   @default("Consulta Nutricional Eva Vidal")
  notes          String?
  meetUrl        String?
  emailSent      Boolean   @default(false)
  emailSentAt    DateTime?
  reminderSent   Boolean   @default(false)
  reminderSentAt DateTime?
  rescheduleTokenHash String? @unique
  rescheduleTokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  requests       AppointmentRequest[]

  @@index([patientId])
  @@index([date])
}

model WaitlistEntry {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  preferredFrom DateTime?
  preferredTo   DateTime?
  notes         String?
  status        String   @default("WAITING") // WAITING | CONTACTED | BOOKED | CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([patientId])
}

model Invoice {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId     String?
  patient       Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  number        String   @unique
  description   String
  amountCents   Int
  paidCents     Int      @default(0)
  currency      String   @default("EUR")
  status        String   @default("DRAFT") // DRAFT | SENT | PARTIALLY_PAID | PAID | OVERDUE | VOID
  dueDate       DateTime?
  issuedAt      DateTime @default(now())
  paidAt        DateTime?
  paymentMethod String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments      Payment[]

  @@index([userId, status])
  @@index([patientId])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String   // STRIPE | BIZUM | TRANSFER | CASH | CARD | OTHER
  reference   String?
  notes       String?
  paidAt      DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model DataSubjectRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  requestType String   // EXPORT | ERASURE | RECTIFICATION | ACCESS
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REJECTED
  notes       String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([patientId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientId  String?
  patient    Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([patientId])
}

model Food {
  id                   Int                @id @default(autoincrement())
  fdcId                Int?               @unique
  name                 String
  category             String?
  source               String             @default("custom")
  imageUrl             String?
  servingSize          Float              @default(100)
  servingUnit          String             @default("g")
  calories             Float
  proteinG             Float
  carbsG               Float
  fatG                 Float
  fiberG               Float              @default(0)
  sugarG               Float              @default(0)
  saturatedFatG        Float              @default(0)
  monounsaturatedFatG  Float              @default(0)
  polyunsaturatedFatG  Float              @default(0)
  cholesterolMg        Float              @default(0)
  sodiumMg             Float              @default(0)
  potassiumMg          Float              @default(0)
  calciumMg            Float              @default(0)
  ironMg               Float              @default(0)
  vitaminAUg           Float              @default(0)
  vitaminCMg           Float              @default(0)
  vitaminDUg           Float              @default(0)
  vitaminEMg           Float              @default(0)
  vitaminKUg           Float              @default(0)
  vitaminB1Mg          Float              @default(0)
  vitaminB2Mg          Float              @default(0)
  vitaminB3Mg          Float              @default(0)
  vitaminB6Mg          Float              @default(0)
  vitaminB12Ug         Float              @default(0)
  folateUg             Float              @default(0)
  magnesiumMg          Float              @default(0)
  zincMg               Float              @default(0)
  phosphorusMg         Float              @default(0)
  seleniumUg           Float              @default(0)

  // === 5.6 ALIMENTOS: PERFIL COMPLETO Y CONTROL DE CATÁLOGO ===
  iodineUg             Float              @default(0) // Yodo (I)
  omega3G              Float              @default(0) // Omega-3
  addedSugarsG         Float              @default(0) // Azúcares añadidos
  solubleFiberG        Float              @default(0) // Fibra soluble
  insolubleFiberG      Float              @default(0) // Fibra insoluble
  glycemicIndex        Float?             // Índice glucémico
  glycemicLoad         Float?             // Carga glucémica
  fodmapCategory       String?            // "BAJO" | "MEDIO" | "ALTO"
  purinesMg            Float              @default(0) // Purinas mg/100g
  oxalatesMg           Float              @default(0) // Oxalatos mg/100g
  nutriScore           String?            // "A" | "B" | "C" | "D" | "E"
  novaGroup            Int?               // 1 | 2 | 3 | 4
  householdMeasuresJson String            @default("[]") // Medidas caseras: [{"name": "cucharada sopera", "grams": 15}]
  cookedConversionFactor Float?           // Factor peso crudo frente a cocinado (ej. 2.8 arroz, 0.8 pollo)
  ediblePartPercentage Float?             @default(100) // Parte comestible %
  allergensJson        String             @default("[]") // 14 alérgenos de declaración obligatoria
  dietaryTagsJson      String             @default("[]") // "VEGANO", "SIN_GLUTEN", "BAJO_SODIO", etc.
  barcode              String?            @unique // Código de barras EAN-13 para escáner
  brandName            String?            // Marca de supermercado
  dataSource           String             @default("BEDCA") // "BEDCA" | "USDA" | "CIQUAL" | "OPEN_FOOD_FACTS" | "PROPIO"
  isFavorite           Boolean            @default(false)
  isPrivate            Boolean            @default(false)
  userId               String?
  user                 User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  isSupplement         Boolean            @default(false)
  supplementDose       String?            // Dosis recomendada para suplementos
  seasonMonthsJson     String             @default("[]") // Meses de temporada [1..12]
  pricePerKg           Float?             // Precio €/kg
  carbonFootprintKgCo2 Float?             // Huella ambiental kg CO2 eq/kg
  waterFootprintLiters Float?             // Huella hídrica L/kg

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  recipeIngredients    RecipeIngredient[]
  mealItems            MealItem[]

  @@index([userId])
  @@index([name])
}

model Recipe {
  id           String             @id @default(cuid())
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  servings     Int
  prepTimeMin  Int?
  cookTimeMin  Int?
  instructions String
  category     String?
  imageUrl     String?

  // === 5.7 RECETAS: ETIQUETAS Y EQUIPO ===
  dietaryTagsJson String           @default("[]") // "VEGANO", "SIN_GLUTEN", "SIN_LACTOSA", "FODMAP", "BAJO_SODIO", "APTO_DIABETICO"
  difficulty      String           @default("FACIL") // "FACIL" | "MEDIA" | "DIFICIL"
  estimatedCost   Float?           // Coste estimado €/ración
  equipmentJson   String           @default("[]") // "AIRFRYER", "THERMOMIX", "HORNO", "SARTEN", "OLLA_RAPIDA"
  isBatchCooking  Boolean          @default(false)
  isFreezable     Boolean          @default(false)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  ingredients  RecipeIngredient[]
  mealItems    MealItem[]

  @@index([userId])
}

model RecipeIngredient {
  id        String   @id @default(cuid())
  recipeId  String
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  foodId    Int
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  quantityG Float
  notes     String?

  @@index([recipeId])
  @@index([foodId])
}

model MealPlan {
  id             String    @id @default(cuid())
  patientId      String
  patient        Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime?
  targetKcal     Float
  targetProteinG Float
  targetCarbsG   Float
  targetFatG     Float
  notes          String?
  hideCaloriesTCA Boolean  @default(false)
  isGLP1         Boolean   @default(false)
  status         String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  publishedAt    DateTime?
  publishedBy    String?
  checklistPassed Boolean  @default(true)
  clinicalChecklistNotes String?
  isSharedWithPatient Boolean @default(true)
  isActive       Boolean   @default(true)

  // === 5.8 PLANES: MODELOS AVANZADOS, FASES, GESTIÓN Y SALIDAS ===
  planningModel          String            @default("TRADITIONAL") // "TRADITIONAL" | "EXCHANGE" | "FLEXIBLE_RANGES" | "CALORIE_CYCLING" | "INTERMITTENT_FASTING" | "PHASED"
  currentPhase           String?           // "INDUCTION" | "LOSS" | "MAINTENANCE" | "REVERSE_DIET"
  autoTransitionDate     DateTime?
  targetKcalRest         Float?            // Ciclado calórico: calorías en días de descanso
  targetCarbsGRest       Float?            // Ciclado calórico: CH en descanso
  targetProteinGRest     Float?
  targetFatGRest         Float?
  targetKcalMin          Float?            // Rangos flexibles (ej. 1800 - 2000 kcal)
  targetKcalMax          Float?
  targetProteinGMin      Float?
  targetProteinGMax      Float?
  hydrationTargetLiters  Float             @default(2.0)
  supplementationPlanJson String           @default("[]") // Pauta con equivalentes
  eatingOutGuide         String?           // Guía comer fuera, viajes y celebraciones
  version                Int               @default(1)
  previousVersionId      String?
  expiresAt              DateTime?         // Caducidad para aviso de renovación
  firstOpenedByPatientAt DateTime?         // Seguimiento de apertura
  digitalSignatureHash   String?           // Firma digital con QR
  batchCookingGuideJson  String            @default("[]")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  days           DayPlan[]

  @@index([patientId])
  @@index([userId])
}

model DayPlan {
  id         String    @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  dayNumber  Int
  customName String?
  date       DateTime?

  meals      Meal[]

  @@index([mealPlanId])
}

model Meal {
  id          String     @id @default(cuid())
  dayPlanId   String
  dayPlan     DayPlan    @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  mealType    String     // MealType enum values
  order       Int
  isOptionB   Boolean    @default(false)
  optionGroup String?    // Grupo para opciones A/B
  isCheatMeal Boolean    @default(false) // Comida libre
  timingType  String     @default("REGULAR") // "REGULAR" | "PRE_WORKOUT" | "POST_WORKOUT" | "SNACK"

  items       MealItem[]

  @@index([dayPlanId])
}

model MealItem {
  id                  String   @id @default(cuid())
  mealId              String
  meal                Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  foodId              Int?
  food                Food?    @relation(fields: [foodId], references: [id], onDelete: SetNull)
  recipeId            String?
  recipe              Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  quantityG           Float
  servings            Float    @default(1)
  exchangeServings    Float?   // Raciones por sistema de intercambios
  exchangeGroup       String?  // "LACTEOS" | "VERDURAS" | "FRUTAS" | "FARINACEOS" | "PROTEICOS" | "GRASAS"
  portionMeasureName  String?  // Medida casera (ej. "cucharada", "puñado")
  portionMeasureGrams Float?   // Gramos de la medida casera
  isAlternative       Boolean  @default(false) // Opción B de ingrediente
  notes               String?

  @@index([mealId])
  @@index([foodId])
  @@index([recipeId])
}

model PatientConsent {
  id               String    @id @default(cuid())
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type             String    // "RGPD" | "INFORMED_CONSENT" | "IMAGE_RIGHTS" | "ONLINE_CONSULTATION"
  title            String
  version          String    @default("1.0")
  status           String    @default("NOT_SENT") // "NOT_SENT" | "SENT" | "IN_PROGRESS" | "COMPLETED"
  sentAt           DateTime?
  viewedAt         DateTime?
  accepted         Boolean   @default(false)
  acceptedAt       DateTime?
  signatureData    String?   // Base64 signature image or confirmation hash
  ipAddress        String?
  userAgent        String?
  revokedAt        DateTime?
  revocationReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
}

model PatientDocument {
  id                  String    @id @default(cuid())
  patientId           String
  patient             Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title               String
  category            String    // "ANALYSIS" | "MEDICAL_REPORT" | "BODY_COMP" | "DIET_HISTORY" | "OTHER"
  fileUrl             String
  fileName            String
  fileSizeKb          Int?
  mimeType            String?
  isSharedWithPatient Boolean   @default(true)
  notes               String?
  uploadedAt          DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([patientId])
}

model EmailLog {
  id             String    @id @default(cuid())
  recipientEmail String
  recipientName  String?
  patientId      String?
  patient        Patient?  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  subject        String
  type           String    // "APPOINTMENT" | "REMINDER_24H" | "PLAN_PUBLISHED" | "ANAMNESIS" | "PORTAL_INVITE" | "SECURITY"
  status         String    // "SENT" | "FAILED"
  errorDetails   String?
  sentAt         DateTime  @default(now())

  @@index([patientId])
  @@index([sentAt])
}

model EmergencyLockdown {
  id               String    @id @default(cuid())
  isActive         Boolean   @default(false)
  activatedAt      DateTime?
  expiresAt        DateTime?
  reason           String?
  activatedByEmail String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ClinicalScreening {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  type           String   // "SCOFF" | "MEDAS" | "FINDRISC" | "MUST" | "MNA" | "IPAQ"
  score          Float
  maxScore       Float?
  resultCategory String   // "BAJO_RIESGO" | "MODERADO" | "ALTO_RIESGO" | "ADHERENCIA_ALTA", etc.
  answersJson    String   @default("{}")
  notes          String?
  createdAt      DateTime @default(now())

  @@index([patientId, type])
}

model ProgressPhoto {
  id           String   @id @default(cuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  photoUrl     String
  label        String?  // "Frontal" | "Lateral" | "Posterior"
  notes        String?
  consentGiven Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([patientId])
}

// === 5.4 CUESTIONARIOS Y FIRMAS ===

model QuestionnaireTemplate {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "ALTA" | "DEPORTIVA" | "PEDIATRICA" | "EMBARAZO" | "TCA" | "SEGUIMIENTO" | "SATISFACCION" | "PERSONALIZADO"
  title       String
  description String?
  schemaJson  String   // JSON con preguntas condicionales, opciones y validaciones
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patientQuestionnaires PatientQuestionnaire[]

  @@index([userId])
}

model PatientQuestionnaire {
  id                   String                 @id @default(cuid())
  patientId            String
  patient              Patient                @relation(fields: [patientId], references: [id], onDelete: Cascade)
  templateId           String?
  template             QuestionnaireTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  type                 String                 @default("ALTA") // "ALTA" | "DEPORTIVA" | "PEDIATRICA" | "EMBARAZO" | "TCA" | "SEGUIMIENTO" | "SATISFACCION"
  title                String
  status               String                 @default("NOT_SENT") // "NOT_SENT" | "SENT" | "IN_PROGRESS" | "COMPLETED"
  sentAt               DateTime?
  openedAt             DateTime?
  completedAt          DateTime?
  draftAnswersJson     String?                // Autoguardado en borrador mientras el paciente rellena
  answersJson          String?                // Respuestas finales enviadas
  attachmentsJson      String?                // JSON array de analíticas/fotos adjuntadas
  redFlagsJson         String?                // Banderas rojas clínicas calculadas
  pendingFieldsCount   Int                    @default(0)
  reviewedFieldsCount  Int                    @default(0)
  isReopened           Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([patientId, status])
}

// === 5.5 AGENDA Y SOLICITUDES DE CITA ===

model AppointmentRequest {
  id                 String       @id @default(cuid())
  patientId          String
  patient            Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId      String?
  appointment        Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  type               String       @default("NEW") // "NEW" | "RESCHEDULE" | "CANCEL"
  status             String       @default("PENDING") // "PENDING" | "ACCEPTED" | "REJECTED"
  appointmentType    String       @default("REVISION") // "PRIMERA" | "REVISION" | "ONLINE" | "DOMICILIO" | "GRUPAL"
  modality           String       @default("ONLINE") // "ONLINE" | "PRESENCIAL"
  preferredTimeOfDay String?      // "MORNING" | "AFTERNOON" | "ANY"
  preferredDays      String?      // "L,X,V"
  reason             String?
  patientNotes       String?
  proposedDate       DateTime?
  adminNotes         String?
  resolvedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([patientId, status])
}

model AgendaBlock {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  reason        String   @default("OTRO") // "VACACIONES" | "FORMACION" | "FESTIVO" | "PERSONAL" | "OTRO"
  startDateTime DateTime
  endDateTime   DateTime
  allDay        Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@index([userId, startDateTime])
}

// === 5.8 REGLAS DE ABSORCIÓN E INTERACCIONES DE NUTRIENTES ===
model AbsorptionInteractionRule {
  id                    String   @id @default(cuid())
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  nutrientTarget        String   // "HIERRO" | "CALCIO" | "ZINC"
  inhibitorKeywordsJson String   // e.g. ["cafe", "te", "calcio", "leche", "queso", "lacteo", "fibra_excesiva"]
  enhancerKeywordsJson  String   // e.g. ["vitamina_c", "naranja", "limon", "kiwi", "pimiento", "fresas"]
  recommendationMessage String   // Recomendación para Eva
  suggestedAdjustment   String?  // Ajuste sugerido
  isEnabled             Boolean  @default(true)
  isCustom              Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, nutrientTarget])
}

// === 5.6 CONTROL DE CALIDAD DEL CATÁLOGO: FUSIONES DE DUPLICADOS ===
model FoodDuplicateMergeLog {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryFoodId          Int
  mergedFoodId           Int
  primaryFoodName        String
  mergedFoodName         String
  mergedRecipeItemsCount Int      @default(0)
  mergedMealItemsCount   Int      @default(0)
  createdAt              DateTime @default(now())

  @@index([userId])
}

// === 5.9 PROTOCOLOS CLÍNICOS AVANZADOS ===
model ClinicalProtocolRecord {
  id              String    @id @default(cuid())
  patientId       String
  patient         Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type            String    // DIABETES_CGM | RENAL | DASH_HTA | DISLIPEMIA | GOTA | ANEMIA | CELIAQUIA | EII_SIBO | FODMAP_PHASES | EMBARAZO_LACTANCIA | PEDIATRIA | MENOPAUSIA | BARIATRICA | DISFAGIA_IDDSI | DEPORTE | KETO
  title           String
  phase           String?   // Para protocolos por fases (FODMAP, Bariátrica, SIBO, etc.)
  parametersJson  String    @default("{}") // Parámetros clínicos estructurados (ratios, CGM, texturas, suplementación)
  symptomLogJson  String    @default("[]") // Diario de síntomas asociado
  notes           String?
  startDate       DateTime  @default(now())
  endDate         DateTime?
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED | PAUSED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([patientId, type])
}

// === 5.10 CALCULADORA CLÍNICA & EVALUACIONES DE RIESGO ===
model CalculatorResultRecord {
  id                     String    @id @default(cuid())
  patientId              String
  patient                Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  formula                String    // HARRIS_BENEDICT | MIFFLIN | KATCH | CUNNINGHAM | SCHOFIELD | FAO_OMS | OWEN | IRETON_JONES | PENN_STATE
  bmrKcal                Float
  tdeeKcal               Float
  activityFactor         Float
  specialNeedsJson       String?   // Ajustes embarazo, lactancia, edad, renal
  stepsOrMetsJson        String?   // Gasto adicional por pasos o METs
  weightPredictionJson   String?   // Modelo dinámico NIH Body Weight Planner y escenarios
  cardiovascularRiskJson String?   // SCORE2, REGICOR, FINDRISC, Síndrome Metabólico
  micronutrientDriJson   String?   // DRI micronutrientes calculados
  notes                  String?
  createdAt              DateTime  @default(now())

  @@index([patientId, createdAt])
}


